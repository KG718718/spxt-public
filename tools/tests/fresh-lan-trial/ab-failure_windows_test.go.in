package main

import (
	"bufio"
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"syscall"
	"testing"
	"time"
)

type freshAbController struct {
	cmd            *exec.Cmd
	input          io.WriteCloser
	rows           chan map[string]any
	readerDone     chan struct{}
	protocolFailed bool
	stderr         bytes.Buffer
}

func freshAbCredentialFreeEnvironment(values []string) []string {
	result := []string{}
	for _, value := range values {
		name := strings.ToUpper(strings.SplitN(value, "=", 2)[0])
		secret := name == "GH_TOKEN" || name == "GITHUB_TOKEN"
		for _, suffix := range []string{"_TOKEN", "_SECRET", "_PASSWORD", "_PRIVATE_KEY", "_CREDENTIAL", "_API_KEY"} {
			secret = secret || strings.HasSuffix(name, suffix)
		}
		if !secret {
			result = append(result, value)
		}
	}
	return result
}
func TestFreshAbAdmissionEnvironment(t *testing.T) {
	got := freshAbCredentialFreeEnvironment([]string{"PATH=owned", "GH_TOKEN=SENTINEL", "GITHUB_TOKEN=SENTINEL", "ACTIONS_RUNTIME_TOKEN=SENTINEL", "ACTIONS_ID_TOKEN_REQUEST_TOKEN=SENTINEL", "TEST_SECRET=SENTINEL", "SystemRoot=owned"})
	if len(got) != 2 || got[0] != "PATH=owned" || got[1] != "SystemRoot=owned" {
		t.Fatal("AB_CREDENTIAL_PROPAGATION")
	}
}
func freshAbInstallAdmission(node, repo, base, source, role string) bool {
	return freshAbInstallAdmissionWithin(node, repo, base, source, role, 120*time.Second)
}
func freshAbHex(value any, length int) bool {
	s, ok := value.(string)
	if !ok || len(s) != length {
		return false
	}
	for _, c := range s {
		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
			return false
		}
	}
	return true
}
func freshAbId(value any) bool {
	s, ok := value.(string)
	if !ok || len(s) == 0 || s[0] == '0' {
		return false
	}
	for _, c := range s {
		if c < '0' || c > '9' {
			return false
		}
	}
	return true
}
func freshAbAdmissionSafe(value map[string]any, source, role string) bool {
	if value["schema"] != float64(1) || value["kind"] != "AB_INSTALL_ADMISSION" {
		return false
	}
	if value["status"] == "FAIL" {
		if len(value) != 5 {
			return false
		}
		c, ok := value["classification"].(string)
		if !ok {
			return false
		}
		known := false
		for _, allowed := range []string{"API_QUERY_UNKNOWN", "API_DATA_UNKNOWN", "ADMISSION_PROCESS_TIMEOUT_UNKNOWN", "HISTORY_SNAPSHOT_UNKNOWN", "HISTORY_SCOPE_REJECTED", "AUTHORIZATION_REJECTED", "MASTER_APPROVAL_MISSING", "MASTER_APPROVAL_REJECTED", "ENVIRONMENT_PROTECTION_REJECTED", "JOB_STATE_UNKNOWN", "JOB_STATE_REJECTED"} {
			known = known || c == allowed
		}
		obs := "REJECTED"
		if strings.HasSuffix(c, "_UNKNOWN") || c == "MASTER_APPROVAL_MISSING" {
			obs = "UNKNOWN"
		}
		return known && value["observation"] == obs
	}
	if len(value) != 12 || value["status"] != "PASS" || value["classification"] != "ADMITTED" || value["observation"] != "OBSERVED" || value["sourceCommit"] != source || !freshAbHex(value["sourceCommit"], 40) || !freshAbHex(value["controlCommit"], 40) || value["attempt"] != float64(1) || value["role"] != role || !freshAbId(value["runId"]) || !freshAbId(value["jobId"]) {
		return false
	}
	b, ok := value["runBinding"].(map[string]any)
	return ok && len(b) == 4 && b["schema"] == float64(1) && freshAbHex(b["approvalSha256"], 64) && freshAbHex(b["historySha256"], 64) && freshAbHex(b["authorizationSha256"], 64)
}
func freshAbInstallAdmissionWithin(node, repo, base, source, role string, deadline time.Duration) bool {
	result := map[string]any{"schema": 1, "kind": "AB_INSTALL_ADMISSION", "status": "FAIL", "classification": "API_QUERY_UNKNOWN", "observation": "UNKNOWN"}
	cmd := exec.Command(node, filepath.Join(repo, "tools/windows-installer/fresh-trial/ab/runtime-gate.cjs"), repo, os.Getenv("KSESSION_FRESH_PHYSICAL_WORK"), role)
	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
	cmd.Env = freshAbCredentialFreeEnvironment(os.Environ())
	var out, errOut bytes.Buffer
	cmd.Stdout = &out
	cmd.Stderr = &errOut
	var e error
	timedOut := false
	if e = cmd.Start(); e == nil {
		done := make(chan error, 1)
		go func() { done <- cmd.Wait() }()
		select {
		case e = <-done:
		case <-time.After(deadline):
			timedOut = true
			cmd.Process.Kill()
			select {
			case <-done:
			case <-time.After(5 * time.Second):
			}
			e = fmt.Errorf("ADMISSION_PROCESS_TIMEOUT_UNKNOWN")
		}
	}
	known := map[string]any{}
	if !timedOut && errOut.Len() == 0 && out.Len() <= 16384 && freshNoDuplicateJSON(json.NewDecoder(bytes.NewReader(out.Bytes())), 0) && json.Unmarshal(out.Bytes(), &known) == nil {
		if freshAbAdmissionSafe(known, source, role) && (known["status"] != "PASS" || e == nil) {
			result = known
		} else {
			result = map[string]any{"schema": 1, "kind": "AB_INSTALL_ADMISSION", "status": "FAIL", "classification": "API_DATA_UNKNOWN", "observation": "UNKNOWN"}
		}
	}
	if timedOut {
		result = map[string]any{"schema": 1, "kind": "AB_INSTALL_ADMISSION", "status": "FAIL", "classification": "ADMISSION_PROCESS_TIMEOUT_UNKNOWN", "observation": "UNKNOWN"}
	}
	encoded, writeError := json.Marshal(result)
	if writeError != nil || os.WriteFile(filepath.Join(base, "installation-admission.json"), append(encoded, '\n'), 0600) != nil {
		return false
	}
	return e == nil && errOut.Len() == 0 && len(result) == 12 && result["status"] == "PASS" && result["classification"] == "ADMITTED" && result["observation"] == "OBSERVED" && result["sourceCommit"] == source && result["role"] == role
}
func TestFreshAbAdmissionProcess(t *testing.T) {
	node := os.Getenv("KSESSION_FRESH_TEST_NODE")
	if node == "" {
		t.Fatal("PINNED_NODE_REQUIRED")
	}
	t.Setenv("GH_TOKEN", "PRIVATE_TOKEN_SENTINEL")
	for _, kind := range []string{"positive", "invalid", "extra", "stderr", "nonzero", "timeout"} {
		t.Run(kind, func(t *testing.T) {
			root := t.TempDir()
			script := filepath.Join(root, "tools/windows-installer/fresh-trial/ab/runtime-gate.cjs")
			if os.MkdirAll(filepath.Dir(script), 0700) != nil {
				t.Fatal("PRIVATE_SCRIPT_CREATE_FAILED")
			}
			body := `if(Object.keys(process.env).some(k=>/TOKEN|SECRET|PASSWORD/.test(k))){process.exit(7)};const r={schema:1,kind:'AB_INSTALL_ADMISSION',status:'PASS',classification:'ADMITTED',observation:'OBSERVED',sourceCommit:'a'.repeat(40),controlCommit:'b'.repeat(40),runId:'900',attempt:1,role:'A',jobId:'100',runBinding:{schema:1,approvalSha256:'c'.repeat(64),historySha256:'d'.repeat(64),authorizationSha256:'e'.repeat(64)}};`
			switch kind {
			case "positive":
				body += `process.stdout.write(JSON.stringify(r))`
			case "invalid":
				body += `process.stdout.write('INVALID')`
			case "extra":
				body += `process.stdout.write(JSON.stringify({...r,raw:'PRIVATE_SENTINEL'}))`
			case "stderr":
				body += `process.stderr.write('PRIVATE_SENTINEL')`
			case "nonzero":
				body += `process.stdout.write(JSON.stringify(r));process.exitCode=1`
			case "timeout":
				body += `setInterval(()=>{},1000)`
			}
			if os.WriteFile(script, []byte(body), 0600) != nil {
				t.Fatal("PRIVATE_SCRIPT_WRITE_FAILED")
			}
			deadline := 5 * time.Second
			if kind == "timeout" {
				deadline = 100 * time.Millisecond
			}
			accepted := freshAbInstallAdmissionWithin(node, root, root, strings.Repeat("a", 40), "A", deadline)
			if accepted != (kind == "positive") {
				t.Fatal("ADMISSION_PROCESS_OUTCOME_WRONG")
			}
			data, e := os.ReadFile(filepath.Join(root, "installation-admission.json"))
			if e != nil || bytes.Contains(data, []byte("PRIVATE_SENTINEL")) {
				t.Fatal("ADMISSION_PRIVACY_OR_REPORT_FAILED")
			}
			var report map[string]any
			if json.Unmarshal(data, &report) != nil {
				t.Fatal("ADMISSION_REPORT_INVALID")
			}
			if kind == "timeout" && report["classification"] != "ADMISSION_PROCESS_TIMEOUT_UNKNOWN" {
				t.Fatal("ADMISSION_TIMEOUT_SUBTYPE_LOST")
			}
		})
	}
}

func (c *freshAbController) line() map[string]any {
	return c.lineWithin(20 * time.Second)
}
func (c *freshAbController) lineWithin(deadline time.Duration) map[string]any {
	if c.protocolFailed {
		return nil
	}
	select {
	case value := <-c.rows:
		if value == nil {
			c.protocolFailed = true
		}
		return value
	case <-time.After(deadline):
		c.protocolFailed = true
		return nil
	}
}
func freshAbReady(value map[string]any) (bool, bool) {
	if len(value) != 4 || value["schema"] != float64(1) || value["kind"] != "AB_FAILURE_DIRECTORY_READY" || value["createdNew"] != true {
		return false, false
	}
	ready, known := value["ready"].(bool)
	return known, ready
}
func freshAbRestored(value map[string]any, creationComplete bool) bool {
	return len(value) == 4 && value["schema"] == float64(1) && value["kind"] == "AB_FAILURE_DIRECTORY_RESTORED" && value["state"] == "OWNED_REMOVED" && value["creationComplete"] == creationComplete
}
func (c *freshAbController) startReader(input io.Reader) {
	c.rows = make(chan map[string]any, 3)
	c.readerDone = make(chan struct{})
	go func() {
		defer close(c.readerDone)
		defer close(c.rows)
		reader := bufio.NewReaderSize(input, 4096)
		for index := 0; index < 3; index++ {
			line, e := reader.ReadSlice('\n')
			if e == io.EOF && len(line) == 0 {
				return
			}
			if e != nil || index == 2 || !freshNoDuplicateJSON(json.NewDecoder(bytes.NewReader(line)), 0) {
				c.rows <- nil
				return
			}
			var value map[string]any
			if json.Unmarshal(line, &value) != nil {
				c.rows <- nil
				return
			}
			c.rows <- value
		}
	}()
}
func freshStartAbController(ps, repo, base, name string) (*freshAbController, map[string]any) {
	c := &freshAbController{}
	c.cmd = exec.Command(ps, "-NoLogo", "-NoProfile", "-NonInteractive", "-File", filepath.Join(repo, "tools/tests/fresh-lan-trial/install-r2/owned-failure-directory.ps1"), "-Base", base, "-Name", name)
	c.cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
	c.cmd.Stderr = &c.stderr
	var e error
	c.input, e = c.cmd.StdinPipe()
	if e != nil {
		return nil, nil
	}
	out, e := c.cmd.StdoutPipe()
	if e != nil {
		c.input.Close()
		return nil, nil
	}
	if c.cmd.Start() != nil {
		c.input.Close()
		return nil, nil
	}
	c.startReader(out)
	return c, c.line()
}
func (c *freshAbController) end(restore bool) (map[string]any, bool) {
	if c == nil {
		return nil, false
	}
	var value map[string]any
	if restore && !c.protocolFailed {
		if _, e := io.WriteString(c.input, "RESTORE\n"); e == nil {
			value = c.line()
		}
	}
	c.input.Close()
	select {
	case <-c.readerDone:
		if len(c.rows) != 0 {
			c.protocolFailed = true
		}
	case <-time.After(20 * time.Second):
		c.protocolFailed = true
	}
	done := make(chan error, 1)
	go func() { done <- c.cmd.Wait() }()
	select {
	case e := <-done:
		return value, e == nil && c.stderr.Len() == 0 && !c.protocolFailed
	case <-time.After(20 * time.Second):
		return value, false
	}
}

func TestFreshAbControllerProtocol(t *testing.T) {
	for _, text := range []string{"", "INVALID\n", "{\"schema\":1,\"schema\":1}\n", "{\"schema\":1}"} {
		c := &freshAbController{}
		c.startReader(bytes.NewBufferString(text))
		if c.lineWithin(time.Second) != nil || !c.protocolFailed {
			t.Fatal("PROTOCOL_INVALID_ACCEPTED")
		}
	}
	reader, writer := io.Pipe()
	c := &freshAbController{}
	c.startReader(reader)
	if c.lineWithin(time.Millisecond) != nil || !c.protocolFailed {
		t.Fatal("READY_TIMEOUT_ACCEPTED")
	}
	writer.Close()
	<-c.readerDone
	if c.lineWithin(time.Second) != nil {
		t.Fatal("TIMEOUT_READER_REUSED")
	}
	reader, writer = io.Pipe()
	c = &freshAbController{}
	c.startReader(reader)
	go func() { io.WriteString(writer, "{\"schema\":1}\n") }()
	if c.lineWithin(time.Second) == nil || c.lineWithin(time.Millisecond) != nil || !c.protocolFailed {
		t.Fatal("RESTORE_TIMEOUT_ACCEPTED")
	}
	writer.Close()
	<-c.readerDone
	for _, extra := range []map[string]any{
		{"schema": float64(1), "kind": "AB_FAILURE_DIRECTORY_RESTORED", "state": "OWNED_REMOVED", "creationComplete": false, "extra": true},
		{"schema": float64(1), "kind": "AB_FAILURE_DIRECTORY_RESTORED", "state": "OWNED_REMOVED", "creationComplete": "false"},
	} {
		if freshAbRestored(extra, false) {
			t.Fatal("UNKNOWN_RESTORE_FIELDS_ACCEPTED")
		}
	}
	c = &freshAbController{}
	c.startReader(bytes.NewBufferString("{\"schema\":1}\n"))
	if c.lineWithin(time.Second) == nil || c.lineWithin(time.Second) != nil || !c.protocolFailed {
		t.Fatal("RESTORE_EOF_ACCEPTED")
	}
	for _, value := range []map[string]any{{"schema": float64(1), "kind": "AB_FAILURE_DIRECTORY_READY", "createdNew": true, "ready": true, "extra": "FORBIDDEN"}, {"schema": float64(1), "kind": "AB_FAILURE_DIRECTORY_READY", "createdNew": true, "ready": "true"}} {
		if known, _ := freshAbReady(value); known {
			t.Fatal("UNKNOWN_READY_FIELDS_ACCEPTED")
		}
	}
}

// Called only by the real Hosted B core after all five rejection fixtures have
// restored. Local tests never invoke the formal product Setup.
func freshRunAbFailedInstall(ps, node, repo, base, setup, source, setupHash string, paths map[string]string, pre map[string]freshRecoverySnapshot, pending *bool) bool {
	if !freshAbInstallAdmission(node, repo, base, source, "B") {
		return false
	}
	proof := map[string]bool{}
	for _, k := range []string{"logKnown", "preInstallReady", "nativeInstallStarted", "controlledDirectoryAttempt", "accessDenied5", "fatalInstall4", "nativeRollback", "postInstallNotReached", "setupNaturalExit", "sameExe", "creatorReady", "aclRestored", "creatorHandlesClosed"} {
		proof[k] = false
	}
	recovery := map[string]string{}
	for _, k := range []string{"productRegistration", "binding", "startup", "desktop", "programs", "programFiles", "failedTarget", "failedInstance"} {
		recovery[k] = "NOT_OBSERVED"
	}
	report := map[string]any{"schema": 1, "kind": "FRESH_AB_FAILED_NATIVE_INSTALL", "sourceCommit": source, "setupSha256": setupHash, "status": "FAIL", "mechanism": "OWNED_NONINHERITING_DENY_ADD_SUBDIRECTORY", "controllerState": "NOT_STARTED", "setupExitCode": -1, "proof": proof, "recovery": recovery}
	write := func() {
		b, e := json.Marshal(report)
		if e == nil {
			os.WriteFile(filepath.Join(base, "failed-install.json"), append(b, '\n'), 0600)
		}
	}
	defer write()
	product := `Software\Microsoft\Windows\CurrentVersion\Uninstall\KSESSION-Beta-Installer-v1_is1`
	binding := `Software\KSESSION\Beta\InstallerBinding`
	before := map[string]freshRecoverySnapshot{}
	for _, key := range []string{"productRegistration", "binding", "startup", "desktop", "programs", "programFiles"} {
		var state freshRecoverySnapshot
		switch key {
		case "productRegistration":
			state = freshObserveRegistration(ps, product)
		case "binding":
			state = freshObserveRegistration(ps, binding)
		default:
			state = freshObservePath(paths[key])
		}
		if !pre[key].Known || !pre[key].Absent || !state.Known || !state.Absent {
			return false
		}
		before[key] = state
	}
	name := fmt.Sprintf("ab-failure-%032x", time.Now().UnixNano())
	target := filepath.Join(base, name)
	instance := filepath.Join(base, name+"-instance")
	targetBefore, instanceBefore := freshObservePath(target), freshObservePath(instance)
	if !targetBefore.Known || !targetBefore.Absent || !instanceBefore.Known || !instanceBefore.Absent {
		return false
	}
	if hash, e := hashFile(setup); e != nil || hash != setupHash {
		return false
	}
	proof["sameExe"] = true
	c, ready := freshStartAbController(ps, repo, base, name)
	if c == nil {
		return false
	}
	controllerEnded := false
	defer func() {
		if !controllerEnded {
			_, proof["creatorHandlesClosed"] = c.end(false)
		}
	}()
	creatorKnown, creatorReady := freshAbReady(ready)
	proof["creatorReady"] = creatorKnown && creatorReady
	if !proof["creatorReady"] {
		report["controllerState"] = "READY_UNPROVEN"
		if creatorKnown {
			report["controllerState"] = "CREATION_INCOMPLETE"
		}
		partial, closed := c.end(creatorKnown)
		proof["creatorHandlesClosed"] = closed
		after := freshObservePath(target)
		if creatorKnown && closed && freshAbRestored(partial, false) && after.Known && after.Absent {
			recovery["failedTarget"] = "OWNED_REMOVED"
		}
		controllerEnded = true
		return false
	}
	log := filepath.Join(base, "failed-native-install.log")
	if s := freshObservePath(log); !s.Known || !s.Absent {
		return false
	}
	cmd := exec.Command(setup, "/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART", "/SP-", "/CURRENTUSER", "/DIR="+target, "/INSTANCE="+instance, "/LOG="+log)
	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
	code := -1
	natural := false
	if cmd.Start() == nil {
		*pending = true
		done := make(chan error, 1)
		go func() { done <- cmd.Wait() }()
		select {
		case <-done:
			*pending = false
			natural = true
			code = cmd.ProcessState.ExitCode()
		case <-time.After(5 * time.Minute):
			return false
		}
	}
	text, logError := os.ReadFile(log)
	if code >= 0 && code <= 255 {
		report["setupExitCode"] = code
	}
	if logError == nil && len(text) <= 4*1024*1024 {
		input, _ := json.Marshal(map[string]any{"text": decodeInstallerLog(text), "target": target, "exitCode": code, "natural": natural})
		observe := exec.Command(node, filepath.Join(repo, "tools/tests/fresh-lan-trial/ab-failure.cjs"))
		observe.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
		observe.Stdin = bytes.NewReader(input)
		var out, errOut bytes.Buffer
		observe.Stdout = &out
		observe.Stderr = &errOut
		if observe.Run() == nil && errOut.Len() == 0 {
			var known map[string]bool
			if json.Unmarshal(out.Bytes(), &known) == nil && len(known) == 9 {
				for k, v := range known {
					if _, ok := proof[k]; ok {
						proof[k] = v
					}
				}
			}
		}
	}
	restored, closed := c.end(true)
	controllerEnded = true
	proof["creatorHandlesClosed"] = closed
	proof["aclRestored"] = freshAbRestored(restored, true)
	report["controllerState"] = "RESTORE_REPORT_INVALID"
	if value, ok := restored["state"].(string); ok {
		for _, known := range []string{"OWNED_REMOVED", "RETIRED_CHANGED", "OWNERSHIP_UNKNOWN", "ACL_CHANGED", "UNOWNED_CHILDREN_PRESENT", "ACL_RESTORE_UNPROVEN", "DELETE_FAILED", "POST_ABSENCE_UNPROVEN"} {
			if value == known {
				report["controllerState"] = known
			}
		}
	}
	afterTarget, afterInstance := freshObservePath(target), freshObservePath(instance)
	recovery["failedTarget"] = freshRecoveryStatus(targetBefore, afterTarget, proof["aclRestored"] && closed)
	recovery["failedInstance"] = freshRecoveryStatus(instanceBefore, afterInstance, false)
	for key, beforeState := range before {
		var after freshRecoverySnapshot
		switch key {
		case "productRegistration":
			after = freshObserveRegistration(ps, product)
		case "binding":
			after = freshObserveRegistration(ps, binding)
		default:
			after = freshObservePath(paths[key])
		}
		recovery[key] = freshRecoveryStatus(beforeState, after, false)
	}
	for _, v := range proof {
		if !v {
			return false
		}
	}
	for _, v := range recovery {
		if !freshRecoveryRestored(v) {
			return false
		}
	}
	report["status"] = "PASS"
	return true
}
