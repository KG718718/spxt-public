package main

import (
 "encoding/json"
 "fmt"
 "os"
 "os/exec"
 "path/filepath"
 "regexp"
 "strconv"
 "strings"
 "syscall"
 "testing"
 "time"
)

// TestFreshInstalledCore is selected alone. No old upgrade/uninstall tests run.
// No process.Kill cleanup: unknown termination is a failure retained for Master.
func TestFreshInstalledCore(t *testing.T) {
 if os.Getenv("GITHUB_ACTIONS")!="true" || os.Getenv("RUNNER_ENVIRONMENT")!="github-hosted" || os.Getenv("GITHUB_REPOSITORY")!="KG718718/spxt-public" { t.Fatal("HOSTED_ONLY") }
 base, setup, node, repo, commit := os.Getenv("KSESSION_FRESH_EVIDENCE"),os.Getenv("KSESSION_FRESH_SETUP"),os.Getenv("KSESSION_FRESH_TEST_NODE"),os.Getenv("KSESSION_FRESH_REPO"),os.Getenv("KSESSION_FRESH_TESTED_SOURCE")
 if !filepath.IsAbs(base)||!filepath.IsAbs(setup)||!filepath.IsAbs(node)||!filepath.IsAbs(repo)||len(commit)!=40 {t.Fatal("SOURCE_REJECTED")}
 if e:=os.Mkdir(base,0700);e!=nil {t.Fatal("FRESH_EVIDENCE_REQUIRED")}
 stage:="F01"
 checks:=map[string]bool{}
 cleanup:=map[string]any{"ownedLauncherExited":nil,"ownedNodeExited":nil,"handlesClosed":nil,"lockReleased":nil}
 var app *exec.Cmd;var nodePID uint32
 fixturesClean:=true
 setupPending:=false
 setupDiagnostics:=[]map[string]any{}
 installationCreated:=false
 var cleanupInstallation func() bool
 root,instance:=filepath.Join(base,"Installed 中文 with spaces"),filepath.Join(base,"Instance 中文 with spaces")
 launcher:=filepath.Join(root,"program","K-SESSION.exe")
 stop:=func() bool {
  if app==nil {return true}
  cmd:=exec.Command(launcher,"--stop","--instance",instance);cmd.SysProcAttr=&syscall.SysProcAttr{HideWindow:true}
  if cmd.Run()!=nil{return false}
  done:=make(chan error,1);go func(){done<-app.Wait()}()
  select{case e:=<-done:if e!=nil{return false};case <-time.After(20*time.Second):return false}
  if alivePID(nodePID){return false}
  h,e:=syscall.CreateFile(ptr(filepath.Join(instance,".launcher.lock")),syscall.GENERIC_READ|syscall.GENERIC_WRITE,0,nil,syscall.OPEN_EXISTING,syscall.FILE_ATTRIBUTE_NORMAL,0)
  if e!=nil{return false};if syscall.CloseHandle(h)!=nil{return false}
  app=nil;nodePID=0;return true
 }
 defer func(){
  stopped:=stop()&&!setupPending;cleanup["ownedLauncherExited"]=stopped;cleanup["ownedNodeExited"]=stopped;cleanup["handlesClosed"]=stopped;cleanup["lockReleased"]=stopped
  restored:=!installationCreated&&fixturesClean;if installationCreated&&stopped&&cleanupInstallation!=nil{restored=cleanupInstallation()}
  cleanup["ownedRegistrationAbsent"]=restored;cleanup["ownedShortcutsAbsent"]=restored
  status:="PASS";reason:="PASS";if t.Failed()||!stopped||!fixturesClean||!restored{status="FAIL";reason="GATE_FAILED"};if !stopped||!fixturesClean||!restored{reason="CLEANUP_UNPROVEN"}
  report:=map[string]any{"schema":1,"kind":"FRESH_INSTALLED_CORE","sourceCommit":commit,"status":status,"stage":stage,"reason":reason,"checks":checks,"cleanup":cleanup,"fixturesClean":fixturesClean,"setupDiagnostics":setupDiagnostics}
  b,e:=json.Marshal(report);if e!=nil{t.Error("REPORT_INVALID");return};if os.WriteFile(filepath.Join(base,"installed-core.json"),append(b,'\n'),0600)!=nil{t.Error("REPORT_WRITE_FAILED")}
 }()
 run:=func(exe string,args ...string) ([]byte,error){cmd:=exec.Command(exe,args...);cmd.SysProcAttr=&syscall.SysProcAttr{HideWindow:true};return cmd.CombinedOutput()}
 present:=func(p string) bool {_,e:=os.Lstat(p);return !os.IsNotExist(e)}
 product:=`Software\Microsoft\Windows\CurrentVersion\Uninstall\KSESSION-Beta-Installer-v1_is1`
 binding:=`Software\KSESSION\Beta\InstallerBinding`
 for _,hive:=range []syscall.Handle{syscall.HKEY_CURRENT_USER,syscall.HKEY_LOCAL_MACHINE}{for _,view:=range []uint32{0x100,0x200}{for _,key:=range []string{product,binding}{var h syscall.Handle;e:=syscall.RegOpenKeyEx(hive,ptr(key),0,syscall.KEY_READ|view,&h);if e==nil{syscall.RegCloseKey(h);t.Fatal("PREEXISTING_REGISTRATION")};if e!=syscall.ERROR_FILE_NOT_FOUND&&e!=syscall.ERROR_PATH_NOT_FOUND{t.Fatal("REGISTRATION_UNKNOWN")}}}}
 ps:=filepath.Join(os.Getenv("SystemRoot"),"System32","WindowsPowerShell","v1.0","powershell.exe")
 folders,e:=run(ps,"-NoLogo","-NoProfile","-NonInteractive","-Command",`$ErrorActionPreference='Stop';@{desktop=[Environment]::GetFolderPath('Desktop');programs=[Environment]::GetFolderPath('Programs');startup=[Environment]::GetFolderPath('Startup')}|ConvertTo-Json -Compress`)
 if e!=nil{t.Fatal("KNOWN_FOLDERS_UNKNOWN")};var dirs map[string]string;if json.Unmarshal(folders,&dirs)!=nil{t.Fatal("KNOWN_FOLDERS_INVALID")}
 desktop,startup:=filepath.Join(dirs["desktop"],"K⁺-SESSION.lnk"),filepath.Join(dirs["startup"],"K-SESSION Fresh Trial.lnk")
 for _,p:=range []string{desktop,filepath.Join(dirs["programs"],"K⁺-SESSION.lnk"),startup}{if !filepath.IsAbs(p)||present(p){t.Fatal("PREEXISTING_SHORTCUT")}}
 install:=func(label,target,data,log string) bool {
  if label=="FRESH_ACCEPT"{installationCreated=true}
  cmd:=exec.Command(setup,"/VERYSILENT","/SUPPRESSMSGBOXES","/NORESTART","/SP-","/CURRENTUSER","/DIR="+target,"/INSTANCE="+data,"/LOG="+log);cmd.SysProcAttr=&syscall.SysProcAttr{HideWindow:true}
  exitStatus:="PROCESS_START_FAILED"
  if cmd.Start()==nil{
   setupPending=true;done:=make(chan error,1);go func(){done<-cmd.Wait()}()
   select{case <-done:setupPending=false;code:=cmd.ProcessState.ExitCode();names:=[]string{"INNO_EXIT_SUCCESS","INNO_EXIT_INITIALIZE_FAILED","INNO_EXIT_CANCELLED_BEFORE_INSTALL","INNO_EXIT_PREPARE_FAILED","INNO_EXIT_INSTALL_FATAL","INNO_EXIT_CANCELLED_DURING_INSTALL","INNO_EXIT_DEBUGGER_TERMINATED","INNO_EXIT_PREPARE_REJECTED","INNO_EXIT_PREPARE_RESTART_REQUIRED"};exitStatus="INNO_EXIT_UNEXPECTED_NONZERO";if code>=0&&code<len(names){exitStatus=names[code]};case <-time.After(5*time.Minute):exitStatus="PROCESS_TIMEOUT"}
  }
  bytes,e:=os.ReadFile(log);logState:="OBSERVED";if os.IsNotExist(e){logState="MISSING"}else if e!=nil{logState="UNREADABLE"}
  allowed:=map[string]bool{};for _,m:=range []string{"KSESSION_FRESH_REJECT_REGISTRATION","KSESSION_FRESH_REJECT_LEGACY_INSTANCE","KSESSION_FRESH_REJECT_INSTANCE","KSESSION_FRESH_REJECT_TARGET","KSESSION_FRESH_REJECT_STARTUP","KSESSION_FRESH_REJECT_SHORTCUT","KSESSION_REJECT_RUNNING","KSESSION_REJECT_INSTANCE_LOCK","KSESSION_REJECT_PATH","KSESSION_PREINSTALL_READY","KSESSION_FRESH_STARTUP_VERIFIED","KSESSION_INSTALLED_PAYLOAD_VERIFIED","KSESSION_FRESH_STARTUP_CLEANUP_UNKNOWN","KSESSION_FRESH_STARTUP_CLEANUP_UNPROVEN"}{allowed[m]=true}
  markers:=[]string{};seen:=map[string]bool{};markerState:="VALID";ready,post,reject,badCleanup:=false,false,false,false
  for _,m:=range regexp.MustCompile(`KSESSION_[A-Za-z0-9_]+`).FindAllString(string(bytes),-1){
   if allowed[m]{if !seen[m]{seen[m]=true;markers=append(markers,m)};continue}
   if regexp.MustCompile(`^KSESSION_WIZARD_PAGE_[0-9]+$`).MatchString(m)||m=="KSESSION_DESKTOP_LINK"||m=="KSESSION_START_LINK"{continue};markerState="UNKNOWN"
  }
  ready=seen["KSESSION_PREINSTALL_READY"];post=seen["KSESSION_INSTALLED_PAYLOAD_VERIFIED"];for _,m:=range markers{reject=reject||strings.Contains(m,"REJECT");badCleanup=badCleanup||strings.Contains(m,"CLEANUP")}
  outcome:="UNKNOWN";if markerState=="VALID"&&logState=="OBSERVED"&&!badCleanup{if ready&&post&&!reject&&exitStatus=="INNO_EXIT_SUCCESS"{outcome="ACCEPTED"}else if reject&&!ready&&!post&&(exitStatus=="INNO_EXIT_INITIALIZE_FAILED"||exitStatus=="INNO_EXIT_PREPARE_REJECTED"){outcome="REJECTED"}}
  pre,copyState,postState:="NOT_OBSERVED","NOT_OBSERVED","NOT_OBSERVED";if ready{pre="OBSERVED";copyState="UNKNOWN"};if post{copyState="VERIFIED";postState="VERIFIED"};if outcome=="REJECTED"{pre="REJECTED"}
  setupDiagnostics=append(setupDiagnostics,map[string]any{"call":label,"exitStatus":exitStatus,"logState":logState,"markerState":markerState,"markers":markers,"preInstall":pre,"copy":copyState,"postInstall":postState,"outcome":outcome})
  if outcome=="UNKNOWN"{t.Fatal("SETUP_EVIDENCE_UNKNOWN")}
  return outcome=="ACCEPTED"
 }
 rejected:=func(label,target,data string) {t.Helper();if install(label,target,data,filepath.Join(base,label+".log")){t.Fatal("FRESH_REJECTION_FAILED")};if present(filepath.Join(target,"program"))||present(startup)||present(desktop){t.Fatal("REJECT_SIDE_EFFECT")}}
 fixture:=filepath.Join(base,"nonempty-target");if os.Mkdir(fixture,0700)!=nil{t.Fatal("FIXTURE_FAILED")};sentinel:=filepath.Join(fixture,"owned-sentinel.txt");if os.WriteFile(sentinel,[]byte("FRESH_TRIAL_OWNED"),0600)!=nil{t.Fatal("FIXTURE_FAILED")};rejected("NONEMPTY_TARGET",fixture,instance);b,e:=os.ReadFile(sentinel);if e!=nil||string(b)!="FRESH_TRIAL_OWNED"{t.Fatal("REJECT_CHANGED_TARGET")}
 dataFixture:=filepath.Join(base,"existing-data");if os.Mkdir(dataFixture,0700)!=nil{t.Fatal("FIXTURE_FAILED")};if os.WriteFile(filepath.Join(dataFixture,"data.json"),[]byte(`{"users":[]}`),0600)!=nil{t.Fatal("FIXTURE_FAILED")};rejected("EXISTING_INSTANCE",root,dataFixture)
 for _,p:=range []string{desktop,startup}{
  fixturesClean=false
  if os.WriteFile(p,[]byte("FRESH_TRIAL_OWNED_SHORTCUT"),0600)!=nil{t.Fatal("FIXTURE_FAILED")}
  label:="DESKTOP_SHORTCUT";if p==startup{label="STARTUP_SHORTCUT"}
  if install(label,root,instance,filepath.Join(base,label+".log")){t.Fatal("SHORTCUT_REJECTION_FAILED")}
  bytes,e:=os.ReadFile(p);if e!=nil||string(bytes)!="FRESH_TRIAL_OWNED_SHORTCUT"{t.Fatal("SHORTCUT_CHANGED")}
  if os.Remove(p)!=nil{t.Fatal("OWNED_FIXTURE_CLEANUP_FAILED")}
  fixturesClean=true
  if present(filepath.Join(root,"program")){t.Fatal("REJECT_SIDE_EFFECT")}
 }
 reg:=filepath.Join(os.Getenv("SystemRoot"),"System32","reg.exe")
 bindingKey:=`HKCU\`+binding
 fixturesClean=false
 if _,e=run(reg,"add",bindingKey,"/v","FreshTrialOwned","/t","REG_SZ","/d","FRESH_TRIAL_OWNED","/reg:64");e!=nil{t.Fatal("BINDING_FIXTURE_FAILED")}
 owned,e:=run(reg,"query",bindingKey,"/reg:64");if e!=nil{t.Fatal("BINDING_FIXTURE_UNKNOWN")}
 if install("OLD_BINDING",root,instance,filepath.Join(base,"binding-reject.log")){t.Fatal("BINDING_REJECTION_FAILED")}
 after,e:=run(reg,"query",bindingKey,"/reg:64");if e!=nil||digest(owned)!=digest(after){t.Fatal("BINDING_CHANGED")}
 if _,e=run(reg,"delete",bindingKey,"/f","/reg:64");e!=nil{t.Fatal("OWNED_BINDING_CLEANUP_FAILED")}
 fixturesClean=true
 if !install("FRESH_ACCEPT",root,instance,filepath.Join(base,"install.log")){t.Fatal("FRESH_SETUP_FAILED")}
 installationCreated=true
 if !present(launcher)||!present(startup){t.Fatal("INSTALLED_PAYLOAD_MISSING")}
 stateBefore,e:=os.ReadFile(filepath.Join(root,"uninstall","install-state.json"));if e!=nil{t.Fatal("INSTALL_STATE_MISSING")}
 if install("REGISTERED_REJECT",root,instance,filepath.Join(base,"registration-reject.log")){t.Fatal("REGISTERED_INSTALL_ACCEPTED")}
 stateAfter,e:=os.ReadFile(filepath.Join(root,"uninstall","install-state.json"));if e!=nil||digest(stateBefore)!=digest(stateAfter){t.Fatal("REGISTERED_INSTALL_CHANGED")}
 checks["actualSetup"]=true;checks["zeroExit"]=true;checks["freshMode"]=true;checks["preexistingRejected"]=true;checks["rejectionsUnchanged"]=true
 stage="F02"
 identityScript:=`require(process.argv[1]).installedIdentity(process.argv[2],process.argv[3])`
 if _,e=run(node,"-e",identityScript,filepath.Join(repo,"tools","tests","fresh-lan-trial","installed-browser.cjs"),root,commit);e!=nil{t.Fatal("INSTALLED_IDENTITY_FAILED")}
 for _,p:=range []string{"data.json","attachments"}{if present(filepath.Join(instance,p)){t.Fatal("BUSINESS_PRESEEDED")}}
 for _,k:=range []string{"programInventory","runtimeManifest","launcherHash","helperHash","emptyBusiness","noTestPayload"}{checks[k]=true}
 // Runner cleanup of this one proved fresh install; not upgrade/reinstall certification.
 shortcutHashes:=map[string]string{}
 for _,p:=range []string{desktop,filepath.Join(dirs["programs"],"K⁺-SESSION.lnk"),startup}{h,e:=hashFile(p);if e!=nil{t.Fatal("OWNED_SHORTCUT_IDENTITY_MISSING")};shortcutHashes[p]=h}
 uninstall:=filepath.Join(root,"uninstall","unins000.exe");uninstallHash,e:=hashFile(uninstall);if e!=nil{t.Fatal("OWNED_UNINSTALLER_IDENTITY_MISSING")}
 bindingSnapshot,e:=run(reg,"query",bindingKey,"/reg:64");if e!=nil{t.Fatal("OWNED_BINDING_UNREADABLE")}
 productKey:=`HKCU\`+product;productSnapshot,e:=run(reg,"query",productKey,"/reg:64");if e!=nil{t.Fatal("OWNED_REGISTRATION_UNREADABLE")}
 cleanupInstallation=func() bool {
  for p,want:=range shortcutHashes{have,e:=hashFile(p);if e!=nil||have!=want{return false}}
  have,e:=hashFile(uninstall);if e!=nil||have!=uninstallHash{return false}
  currentBinding,e:=run(reg,"query",bindingKey,"/reg:64");if e!=nil||digest(currentBinding)!=digest(bindingSnapshot){return false}
  currentProduct,e:=run(reg,"query",productKey,"/reg:64");if e!=nil||digest(currentProduct)!=digest(productSnapshot){return false}
  rootJSON,_:=json.Marshal(root);instanceJSON,_:=json.Marshal(instance)
  // Unknown registry values/subkeys refuse native uninstall rather than deleting them.
  ownership:=fmt.Sprintf(`$ErrorActionPreference='Stop';$p=[Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('%s');$b=[Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('%s');if(!$p -or !$b){exit 1};$allowed=@('Inno Setup: Setup Version','Inno Setup: App Path','Inno Setup: Icon Group','Inno Setup: User','Inno Setup: Language','Inno Setup: Selected Tasks','Inno Setup: Deselected Tasks','DisplayName','DisplayIcon','UninstallString','QuietUninstallString','DisplayVersion','Publisher','URLInfoAbout','URLUpdateInfo','HelpLink','NoModify','NoRepair','InstallDate','InstallLocation','EstimatedSize');if(@($p.GetValueNames()|Where-Object{$_ -notin $allowed}).Count -or $p.GetSubKeyNames().Count -or @($b.GetValueNames()|Where-Object{$_ -notin @('InstallRoot','Instance')}).Count -or $b.GetSubKeyNames().Count -or $p.GetValue('DisplayVersion') -cne '1.1.0-beta.4' -or $p.GetValue('InstallLocation') -ine (ConvertFrom-Json '%s') -or $b.GetValue('InstallRoot') -ine (ConvertFrom-Json '%s') -or $b.GetValue('Instance') -ine (ConvertFrom-Json '%s')){exit 1};$p.Dispose();$b.Dispose()`,product,binding,strings.ReplaceAll(string(rootJSON),"'","''"),strings.ReplaceAll(string(rootJSON),"'","''"),strings.ReplaceAll(string(instanceJSON),"'","''"))
  if _,e:=run(ps,"-NoLogo","-NoProfile","-NonInteractive","-Command",ownership);e!=nil{return false}
  if _,e:=run(uninstall,"/VERYSILENT","/SUPPRESSMSGBOXES","/NORESTART","/LOG="+filepath.Join(base,"owned-cleanup.log"));e!=nil{return false}
  for p:=range shortcutHashes{if present(p){return false}}
  currentBinding,e=run(reg,"query",bindingKey,"/reg:64");if e!=nil||digest(currentBinding)!=digest(bindingSnapshot){return false}
  if _,e:=run(reg,"delete",bindingKey,"/f","/reg:64");e!=nil{return false}
  for _,view:=range []uint32{0x100,0x200}{for _,key:=range []string{product,binding}{var h syscall.Handle;e:=syscall.RegOpenKeyEx(syscall.HKEY_CURRENT_USER,ptr(key),0,syscall.KEY_READ|view,&h);if e==nil{syscall.RegCloseKey(h);return false};if e!=syscall.ERROR_FILE_NOT_FOUND&&e!=syscall.ERROR_PATH_NOT_FOUND{return false}}}
  return true
 }
 stage="F03"
 start:=func(logon bool) int {
  t.Helper();args:=[]string{"--instance",instance};if logon{args=append([]string{"--logon"},args...)}
  readyBefore:=eventCount(instance,"READY");spawnBefore:=eventCount(instance,"NODE_SPAWN")
  app=exec.Command(launcher,args...);app.SysProcAttr=&syscall.SysProcAttr{HideWindow:true};if app.Start()!=nil{t.Fatal("LAUNCHER_START_FAILED")}
  deadline:=time.Now().Add(30*time.Second);for time.Now().Before(deadline)&&eventCount(instance,"READY")<=readyBefore{if !alivePID(uint32(app.Process.Pid)){t.Fatal("LAUNCHER_EXITED_EARLY")};time.Sleep(50*time.Millisecond)}
  if eventCount(instance,"READY")!=readyBefore+1||eventCount(instance,"NODE_SPAWN")!=spawnBefore+1{t.Fatal("NODE_UNIQUENESS_FAILED")}
  r:=lastEvent(instance,"READY");if r==nil{t.Fatal("READY_MISSING")};nodePID=uint32(r["pid"].(float64));port:=int(r["port"].(float64))
  if !sameFile(procPath(nodePID),filepath.Join(root,"program","runtime","node.exe"))||!ownsLoopback(nodePID,port){t.Fatal("INSTALLED_NODE_OWNERSHIP_FAILED")}
  h,e:=syscall.CreateFile(ptr(filepath.Join(instance,".launcher.lock")),syscall.GENERIC_READ|syscall.GENERIC_WRITE,0,nil,syscall.OPEN_EXISTING,syscall.FILE_ATTRIBUTE_NORMAL,0);if e==nil{syscall.CloseHandle(h);t.Fatal("LOCK_NOT_EXCLUSIVE")};if e!=syscall.Errno(32){t.Fatal("LOCK_UNKNOWN")}
  time.Sleep(200*time.Millisecond);if !alivePID(nodePID)||eventCount(instance,"NODE_SPAWN")!=spawnBefore+1{t.Fatal("NODE_UNSTABLE")};return port
 }
 // --logon suppresses ShellExecute. Actual GUI first start remains HUMAN_PENDING.
 port:=start(true);for _,k:=range []string{"actualInstalledLauncher","ownedInstalledNode","uniqueNode","exclusiveLock"}{checks[k]=true}
 stage="F05"
 browser:=func(phase string,port int){t.Helper();out:=filepath.Join(base,"browser-"+phase+".json");if _,e:=run(node,filepath.Join(repo,"tools","tests","fresh-lan-trial","browser-entry.cjs"),root,commit,"http://127.0.0.1:"+strconv.Itoa(port),strconv.Itoa(int(nodePID)),strconv.Itoa(app.Process.Pid),filepath.Join(base,"private-browser-state.json"),out,phase);e!=nil{t.Fatal("BROWSER_FAILED")};bytes,e:=os.ReadFile(out);if e!=nil{t.Fatal("BROWSER_REPORT_MISSING")};var r struct{Schema int `json:"schema"`;Source string `json:"sourceCommit"`;Phase string `json:"phase"`;Status string `json:"status"`;Method string `json:"method"`;Witnesses map[string]bool `json:"witnesses"`;Closed bool `json:"browserClosed"`};if json.Unmarshal(bytes,&r)!=nil||r.Schema!=1||r.Source!=commit||r.Phase!=phase||r.Status!="PASS"||r.Method!="INSTALLED_PAYLOAD_BROWSER"||!r.Closed||len(r.Witnesses)!=7{t.Fatal("BROWSER_REPORT_INVALID")};for _,k:=range []string{"installedServiceIdentity","headlessBrowser","twoContexts","twoLogins","authorizationIsolation","saveReadback","attachmentUploadDownload"}{if !r.Witnesses[k]{t.Fatal("BROWSER_EVIDENCE_FALSE")};checks[k]=true}}
 browser("FIRST",port);checks["loopbackBootstrap"]=true
 stage="F06"
 if !stop(){t.Fatal("NORMAL_STOP_UNPROVEN")};checks["normalStop"]=true;checks["ownedProcessesExited"]=true;checks["lockReleased"]=true
 before,e:=os.ReadFile(filepath.Join(instance,"data.json"));if e!=nil{t.Fatal("PERSISTENCE_MISSING")}
 // Explicit disabled synthetic binding is never discovery approval or LAN enablement.
 bindingFixture:=`{"adapterId":"11111111-1111-4111-8111-111111111111","address":"192.168.40.10","prefixLength":24,"subnet":"192.168.40.0/24"}`
 if _,e=run(filepath.Join(root,"program","runtime","node.exe"),filepath.Join(root,"program","app","tools","lan-host","config-cli.cjs"),"save","--instance-dir",instance,"--port","8083","--interface-name","ISOLATED_DISABLED_STATE","--enabled","false","--binding",bindingFixture);e!=nil{t.Fatal("DISABLED_CONFIG_SAVE_FAILED")}
 configBefore,e:=os.ReadFile(filepath.Join(instance,"lan-deployment.json"));if e!=nil{t.Fatal("CONFIG_UNREADABLE")}
 var saved map[string]any;if json.Unmarshal(configBefore,&saved)!=nil||saved["enabled"]!=false||saved["port"]!=float64(8083)||len(saved)!=5{t.Fatal("DISABLED_CONFIG_INVALID")}
 port=start(true)
 persisted,e:=os.ReadFile(filepath.Join(instance,"data.json"));if e!=nil||digest(before)!=digest(persisted){t.Fatal("RESTART_PERSISTENCE_CHANGED")}
 if port!=8083{t.Fatal("SAVED_PORT_NOT_USED")}
 configAfter,e:=os.ReadFile(filepath.Join(instance,"lan-deployment.json"));if e!=nil||digest(configBefore)!=digest(configAfter){t.Fatal("CONFIG_PERSISTENCE_CHANGED")}
 browser("RESTART",port);checks["restartPersistence"]=true;checks["configPersistence"]=true
 args:="--logon --instance \""+instance+"\""
 // JSON quotes are only for safe literal construction; arguments are not shell-expanded.
 pjson,_:=json.Marshal(startup);targetJSON,_:=json.Marshal(launcher);argsJSON,_:=json.Marshal(args);wdJSON,_:=json.Marshal(filepath.Join(root,"program"))
 script:=fmt.Sprintf(`$ErrorActionPreference='Stop';$p=ConvertFrom-Json '%s';$w=New-Object -ComObject WScript.Shell;$l=$w.CreateShortcut($p);if($l.TargetPath -cne (ConvertFrom-Json '%s') -or $l.Arguments -cne (ConvertFrom-Json '%s') -or $l.WorkingDirectory -cne (ConvertFrom-Json '%s')){exit 1}`,strings.ReplaceAll(string(pjson),"'","''"),strings.ReplaceAll(string(targetJSON),"'","''"),strings.ReplaceAll(string(argsJSON),"'","''"),strings.ReplaceAll(string(wdJSON),"'","''"))
 if _,e=run(ps,"-NoLogo","-NoProfile","-NonInteractive","-Command",script);e!=nil{t.Fatal("STARTUP_WIRING_FAILED")};checks["loginStartupWiring"]=true
 if !stop(){t.Fatal("NORMAL_STOP_UNPROVEN")}
 stage="F04"
 if _,e=run(node,filepath.Join(repo,"tools","tests","fresh-lan-trial","socket-entry.cjs"),root,commit,filepath.Join(base,"isolated-socket.json"));e!=nil{t.Fatal("ISOLATED_SOCKET_FAILED")}
 stage="F07"
 // Installed fresh helper must reject the virtual runner; the disabled narrow
 // NetSecurity API rule is a separately owned synthetic test, never production trust.
 if _,e=run(filepath.Join(os.Getenv("SystemRoot"),"System32","WindowsPowerShell","v1.0","powershell.exe"),"-NoLogo","-NoProfile","-NonInteractive","-File",filepath.Join(repo,"tools","tests","fresh-lan-trial","firewall-hosted.ps1"),"-Helper",filepath.Join(root,"program","K-SESSION-Firewall.exe"),"-Instance",instance,"-Program",filepath.Join(root,"program","runtime","node.exe"),"-Output",filepath.Join(base,"firewall.json"));e!=nil{t.Fatal("FIREWALL_GATE_FAILED")}
 stage="COMPLETE"
}
